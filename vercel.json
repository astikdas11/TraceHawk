{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd frontend && if [ -z \"$VERCEL_URL\" ]; then echo \"FATAL: VERCEL_URL is not set\" >&2; exit 1; fi && VITE_API_BASE_URL=\"https://${VERCEL_URL}\" npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm ci",
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "excludeFiles": "{frontend/**,backend/tests/**,tests/**,reports/**,notebooks/**,pipeline/**,data/**,models/baseline/**,models/evaluation/**,models/xgboost/**,.venv/**,.vscode/**,.pytest_cache/**,.ruff_cache/**,requirements-phase2.txt,*.zip}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
